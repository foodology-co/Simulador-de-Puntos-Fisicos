rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }

    function isValidSimulationState(data) {
      return data.keys().hasAll(['simulations', 'createdAt'])
        && data.simulations is list
        && data.simulations.size() <= 50;
    }

    match /scenarios/{scenarioId} {
      // Anyone can read a scenario if they have the ID
      allow get: if isValidId(scenarioId);
      allow list: if false;
      // Anyone can create a new scenario
      allow create: if isValidId(scenarioId) && isValidSimulationState(incoming()) && incoming().createdAt == request.time;
      // Allow updates to existing scenarios (auto-sync)
      allow update: if isValidId(scenarioId) 
                    && incoming().keys().hasAll(['simulations']) 
                    && incoming().simulations is list
                    && incoming().simulations.size() <= 60;
      allow delete: if false;
    }
  }
}
